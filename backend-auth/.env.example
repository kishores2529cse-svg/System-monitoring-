# Server Configuration
SERVER_PORT=8080
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=assessment_db
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-user-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=24
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
ADMIN_JWT_EXPIRY_HOURS=12

# Compiler Configuration
COMPILER_TIMEOUT_SECONDS=5
MAX_CODE_SIZE_KB=100
TEMP_DIR=/tmp
